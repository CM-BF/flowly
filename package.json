{
  "name": "paseo-flowly",
  "version": "1.5.0",
  "description": "Flowly: the agent-native workflow for Paseo",
  "keywords": [
    "paseo",
    "paseo-plugin",
    "kanban",
    "agents",
    "workflow",
    "ai-agents"
  ],
  "homepage": "https://github.com/JasprW/flowly#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JasprW/flowly.git"
  },
  "bugs": {
    "url": "https://github.com/JasprW/flowly/issues"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "paseo-plugin.json",
    "OVERVIEW.md",
    "index.client.ts",
    "index.client.tsx",
    "index.server.ts",
    "index.server.tsx",
    "client/",
    "server/",
    "shared/",
    "skills/",
    "assets/",
    "!**/*.test.ts",
    "!**/*.test.tsx",
    "!shared/i18n-keys.ts",
    "!shared/zz-*",
    "npm-shrinkwrap.json",
    "!server/ci/"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "vitest",
    "test:ci": "node --test server/ci/release.checks.mjs",
    "ci:package": "node server/ci/package.mjs"
  },
  "devDependencies": {
    "@getpaseo/plugin": "0.11.2",
    "@getpaseo/protocol": "0.11.2",
    "@tanstack/react-query": "^5.90.11",
    "@types/node": "^22.0.0",
    "@types/react": "~19.2.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0",
    "zod": "^4.4.3"
  },
  "dependencies": {
    "@getpaseo/client": "0.11.2",
    "@modelcontextprotocol/node": "2.1.1",
    "@modelcontextprotocol/server": "2.3.1"
  }
}
